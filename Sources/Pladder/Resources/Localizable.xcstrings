        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten"
          }
        }
      }
    },
    "Hold %@ to dictate (Secure Keyboard Entry is on)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten (sichere Tastatureingabe ist an)"
          }
        }
      }
    },
    "Hold %@ to dictate, then press ⌘V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten, dann ⌘V drücken"
