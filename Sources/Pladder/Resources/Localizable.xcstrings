      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren …"
          }
        }
      }
    },
    "Lets Pladder paste for you. Without it, the text is copied and you press ⌘V.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit fügt Pladder den Text für dich ein. Ohne sie wird er kopiert und du drückst ⌘V."
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört zu …"
          }
        }
