{
  "sourceLanguage": "en",
  "strings": {
    "%@ is a macOS keyboard shortcut and will fire as well.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein macOS-Kurzbefehl und wird ebenfalls ausgelöst."
          }
        }
      }
    },
    "%@ is a macOS keyboard shortcut, so %@ may never reach Pladder. Record another combination.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist ein macOS-Kurzbefehl, deshalb kommt %2$@ vielleicht nie bei Pladder an. Nimm eine andere Kombination auf."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        }
      }
    },
    "Add a rule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel hinzufügen"
          }
        }
      }
    },
    "Add a space after each dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Diktat ein Leerzeichen einfügen"
          }
        }
      }
    },
    "Adds about half a second. A one-time 1.5 GB download from Hugging Face; trained on English, also handles German and Spanish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostet etwa eine halbe Sekunde. Einmaliger Download von 1,5 GB von Hugging Face; auf Englisch trainiert, kann auch Deutsch und Spanisch."
          }
        }
      }
    },
    "Adds about half a second. A one-time 805 MB download from Hugging Face; trained on English, also handles German and Spanish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostet etwa eine halbe Sekunde. Einmaliger Download von 805 MB von Hugging Face; auf Englisch trainiert, kann auch Deutsch und Spanisch."
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben …"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Applies your replacement rules. Edit them in the Dictionary tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet deine Ersetzungsregeln an. Bearbeite sie im Tab „Wörterbuch“."
          }
        }
      }
    },
    "Built into macOS. Adds one to two seconds to each dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In macOS eingebaut. Kostet ein bis zwei Sekunden pro Diktat."
          }
        }
      }
    },
    "Checking the download…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download wird geprüft …"
          }
        }
      }
    },
    "Cleanup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung"
          }
        }
