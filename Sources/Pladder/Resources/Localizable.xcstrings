    "Mute other audio while recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Töne beim Aufnehmen stummschalten"
          }
        }
      }
    },
    "Needed to hear you. Nothing you say leaves this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um dich zu hören. Nichts, was du sagst, verlässt diesen Mac."
          }
        }
      }
    },
    "No Words Yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Wörter"
          }
        }
      }
    },
    "Nothing on screen: the menu bar icon follows your voice. Errors still appear.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts auf dem Bildschirm: Das Symbol in der Menüleiste folgt deiner Stimme. Fehler erscheinen trotzdem."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Only %@ arrived…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %@ angekommen …"
          }
        }
      }
    },
    "Only %@ reached Pladder. If you pressed a regular key too, macOS or another app owns that shortcut; try a different key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Pladder ist nur %@ angekommen. Falls du auch eine normale Taste gedrückt hast, gehört der Kurzbefehl macOS oder einer anderen App; probier eine andere Taste, zum Beispiel Ctrl + Umschalttaste + D."
          }
        }
      }
    },
    "Open System Settings…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen öffnen …"
          }
        }
      }
    },
    "Overlay": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay"
          }
        }
      }
    },
    "Paste the replacement exactly as written, even at the start of a sentence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ersatz genau so einfügen, wie er geschrieben ist, auch am Satzanfang."
          }
        }
      }
    },
