        }
      }
    },
    "Something went wrong. Open the Pladder menu for details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgegangen. Details stehen im Pladder-Menü."
          }
        }
      }
    },
    "The speech model download stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Sprachmodells wurde unterbrochen."
          }
        }
      }
    },
    "“Run the tests” is pasted as “run the tests”. “I” and “API” keep their capital.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Mach weiter“ wird als „mach weiter“ eingefügt. „API“ behält seine Großbuchstaben."
          }
        }
      }
    },
    "A little less accurate. 700 MB.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas weniger genau. 700 MB."
          }
        }
      }
    },
    "Dismiss All": {
      "localizations": {
