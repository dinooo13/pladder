      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren …"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anmelden öffnen"
          }
        }
      }
    },
    "Leave Heard as empty to teach a word, such as a name, that comes out nearly right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass „Gehört als“ leer, um ein Wort wie einen Namen beizubringen, das fast richtig ankommt."
          }
        }
      }
    },
    "Lets Pladder paste for you. Without it, the text is copied and you press ⌘V.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit fügt Pladder den Text für dich ein. Ohne wird er kopiert und du drückst ⌘V."
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört zu …"
          }
        }
      }
    },
