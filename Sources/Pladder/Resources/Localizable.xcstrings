            "state": "translated",
            "value": "Pladder beenden"
          }
        }
      }
    },
    "Recording a shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehl wird aufgenommen"
          }
        }
      }
    },
    "Remove filler words": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllwörter entfernen"
          }
        }
      }
    },
    "Remove the selected rules": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Regeln entfernen"
          }
        }
      }
    },
    "Repairs near misses of the words you list in the Dictionary tab with an empty Heard as.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert fast richtig erkannte Wörter, die du im Tab „Wörterbuch“ mit leerem „Gehört als“ einträgst."
          }
        }
      }
    },
    "Replace with": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzen durch"
          }
        }
      }
    },
