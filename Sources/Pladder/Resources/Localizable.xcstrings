        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "S1-mini von Superwhisper"
          }
        }
      }
    },
    "S1-mini by Superwhisper, 8-bit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "S1-mini von Superwhisper, 8 Bit"
          }
        }
      }
    },
    "Say “comma”, “question mark” or “new paragraph” to type them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Komma“, „Fragezeichen“ oder „neuer Absatz“, um sie zu schreiben."
          }
        }
      }
    },
    "Secure Keyboard Entry is on. A key combination recorded now may not reach Pladder, and one without a regular key will not fire until it is off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Tastatureingabe ist an. Eine jetzt aufgenommene Kombination kommt vielleicht nicht bei Pladder an, und eine ohne normale Taste funktioniert erst, wenn sie wieder aus ist."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen …"
          }
        }
      }
    },
    "Short replies": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Antworten"
          }
        }
