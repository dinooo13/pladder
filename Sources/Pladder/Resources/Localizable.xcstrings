    "The speech model is still loading. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell wird noch geladen. Versuche es gleich noch einmal."
          }
        }
      }
    },
    "Without Accessibility, %@ can’t be detected, so the hands-free key is off until you allow it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bedienungshilfen wird %@ nicht erkannt, deshalb ist die Freihandtaste aus, bis du sie erlaubst."
          }
        }
      }
    },
    "Without Accessibility, %@ can’t be detected. %@ works in its place until you allow it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bedienungshilfen wird %1$@ nicht erkannt. Bis du sie erlaubst, funktioniert %2$@ an ihrer Stelle."
          }
        }
      }
    },
    "Beta. On-device AI fixes self-corrections, lists and punctuation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta. KI auf dem Mac räumt Selbstkorrekturen, Listen und Satzzeichen auf."
          }
        }
      }
    },
    "Hi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi"
          }
        }
      }
    },
    "A one-sentence reply up to ten words: “Yes.” is pasted as “Yes”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Antwort aus einem Satz mit bis zu zehn Wörtern: „Ja.“ wird als „Ja“ eingefügt."
          }
        }
      }
    },
    "Allow Accessibility…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen erlauben …"
          }
        }
      }
    },
    "Allow Microphone…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erlauben …"
          }
        }
      }
    },
    "Apple Intelligence is off, so dictations are pasted without polish. Turn it on in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist aus, deshalb werden Diktate unverändert eingefügt. Schalte es in den Systemeinstellungen ein."
          }
        }
      }
    },
    "Apple Intelligence is unavailable, so dictations are pasted without polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht verfügbar, deshalb werden Diktate unverändert eingefügt."
          }
        }
      }
    },
    "Dismiss “%@” → “%@”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ → „%2$@“ verwerfen"
          }
        }
      }
    },
    "Drop the period after a short reply": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt nach einer kurzen Antwort weglassen"
          }
        }
      }
    },
    "Fixes near misses of the dictionary words whose Heard as is empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert Beinahe-Treffer der Wörter im Wörterbuch, deren „Gehört als“ leer ist."
          }
        }
      }
    },
    "None": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner"
          }
        }
      }
    },
    "Open at Login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Speech Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachmodell"
          }
        }
      }
    },
    "Start a short reply in lowercase": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Antworten klein beginnen"
          }
        }
      }
    },
    "The Apple Intelligence model is still downloading, so dictations are pasted without polish for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell für Apple Intelligence wird noch heruntergeladen, deshalb werden Diktate vorerst unverändert eingefügt."
          }
        }
      }
    },
    "The download did not match the published model and was deleted, so dictations are pasted without polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download stimmte nicht mit dem veröffentlichten Modell überein und wurde gelöscht, deshalb werden Diktate unverändert eingefügt."
          }
        }
      }
    },
    "The download stopped, so dictations are pasted without polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wurde unterbrochen, deshalb werden Diktate unverändert eingefügt."
          }
        }
      }
    },
    "The model could not be saved, probably for lack of disk space, so dictations are pasted without polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte nicht gesichert werden, vermutlich fehlt Speicherplatz, deshalb werden Diktate unverändert eingefügt."
          }
        }
      }
    },
    "This Mac cannot run Apple Intelligence, so dictations are pasted without polish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac läuft Apple Intelligence nicht, deshalb werden Diktate unverändert eingefügt."
          }
        }
      }
    },
    "Leave empty to fix near misses of the replacement, such as a name that comes out nearly right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um Beinahe-Treffer des Ersatzes zu korrigieren, etwa einen Namen, der fast richtig ankommt."
          }
        }
      }
    },
    "What is pasted instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was stattdessen eingefügt wird."
          }
        }
      }
    },
