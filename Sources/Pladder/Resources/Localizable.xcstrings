    "Mute other audio while recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Audiowiedergabe beim Aufnehmen stummschalten"
          }
        }
      }
    },
    "Needed to hear you. Nothing you say leaves this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um dich zu hören. Nichts, was du sagst, verlässt diesen Mac."
          }
        }
      }
    },
    "No Words Yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Wörter"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Only %@ reached Pladder. If you pressed a regular key too, macOS or another app owns that shortcut; try a different key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Pladder ist nur %@ angekommen. Falls du auch eine normale Taste gedrückt hast, gehört der Kurzbefehl macOS oder einer anderen App; probier eine andere Taste, zum Beispiel Control-Umschalt-D."
          }
        }
      }
    },
    "Paste the replacement exactly as written, even at the start of a sentence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ersatz genau so einfügen, wie er geschrieben ist, auch am Satzanfang."
          }
        }
      }
    },
    "Pasted as": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingefügt als"
          }
        }
      }
    },
