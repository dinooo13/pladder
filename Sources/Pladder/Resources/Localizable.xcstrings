      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkfehler"
          }
        }
      }
    },
    "no connection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine Verbindung"
          }
        }
      }
    },
    "replacement": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzung"
          }
        }
      }
    },
    "see it as you speak": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sieh beim Sprechen zu"
          }
        }
      }
    },
    "spoken form": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gesprochene Form"
          }
        }
      }
    },
    "the transfer stalled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Übertragung stockte"
          }
        }
      }
    },
    "timed out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung"
          }
        }
      }
    },
    "⚠️ “a” → “b” and “b” → “a” undo each other; these rules are ignored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ „a“ → „b“ und „b“ → „a“ heben sich gegenseitig auf; diese Regeln werden ignoriert."
          }
        }
      }
    }
  },
  "version": "1.0"
}
