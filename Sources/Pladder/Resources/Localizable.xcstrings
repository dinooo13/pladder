        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen"
          }
        }
      }
    },
    "Play start and stop sounds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start- und Stopptöne abspielen"
          }
        }
