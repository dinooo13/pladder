{
  "sourceLanguage": "en",
  "strings": {
    "%@ is a macOS keyboard shortcut and will fire as well.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein macOS-Kurzbefehl und wird ebenfalls ausgelöst."
          }
        }
      }
    },
    "%@ is a macOS keyboard shortcut, so %@ may never reach Pladder. Record another combination.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist ein macOS-Kurzbefehl, deshalb kommt %2$@ vielleicht nie bei Pladder an. Nimm eine andere Kombination auf."
          }
        }
      }
    },
    "%@ is part of the push-to-talk key, so it can never be pressed separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört zur Push-to-Talk-Taste und kann deshalb nie allein gedrückt werden."
          }
        }
      }
    },
    "A single dot that turns into a level meter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelner Punkt, der zur Pegelanzeige wird."
          }
        }
      }
    },
    "A small pill with a level meter, above the Dock.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Pille mit Pegelanzeige, über dem Dock."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        }
      }
    },
    "Add Examples": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiele hinzufügen"
          }
        }
      }
    },
    "Add a rule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel hinzufügen"
          }
        }
      }
    },
    "Add a space after each dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Diktat ein Leerzeichen einfügen"
          }
        }
      }
    },
    "Add a word Pladder keeps mishearing and what it should be.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Wort hinzu, das Pladder immer wieder falsch versteht, und wie es heißen soll."
          }
        }
      }
    },
    "Add to Dictionary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Wörterbuch hinzufügen"
          }
        }
      }
    },
    "Adds about half a second. A one-time 1.5 GB download from Hugging Face; trained on English, also handles German and Spanish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostet etwa eine halbe Sekunde. Einmaliger Download von 1,5 GB von Hugging Face; auf Englisch trainiert, kann auch Deutsch und Spanisch."
          }
        }
      }
    },
    "Adds about half a second. A one-time 805 MB download from Hugging Face; trained on English, also handles German and Spanish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostet etwa eine halbe Sekunde. Einmaliger Download von 805 MB von Hugging Face; auf Englisch trainiert, kann auch Deutsch und Spanisch."
          }
        }
      }
    },
    "Allow Accessibility Access…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Bedienungshilfen erlauben …"
          }
        }
      }
    },
    "Allow Microphone Access…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf das Mikrofon erlauben …"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben …"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence is off, so dictations paste as dictated. Turn it on in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist aus, deshalb fügen Diktate den Text so ein, wie er diktiert wurde. Schalte es in den Systemeinstellungen ein."
          }
        }
      }
    },
    "Apple Intelligence is unavailable, so dictations paste as dictated.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht verfügbar, deshalb fügen Diktate den Text so ein, wie er diktiert wurde."
          }
        }
      }
    },
    "Applies your replacement rules. Edit them in the Dictionary tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet deine Ersetzungsregeln an. Bearbeite sie im Tab „Wörterbuch“."
          }
        }
      }
    },
    "Built into macOS. Adds one to two seconds to each dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In macOS eingebaut. Kostet ein bis zwei Sekunden pro Diktat."
          }
        }
      }
    },
    "Checking the download…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download wird geprüft …"
          }
        }
      }
    },
    "Cleanup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen"
          }
        }
      }
    },
    "Click, then press the key or combination to use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann die Taste oder Kombination drücken."
          }
        }
      }
    },
    "Click, then press the key or combination to use. Without Accessibility the key must include a regular key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann die Taste oder Kombination drücken. Ohne Bedienungshilfen braucht die Kombination eine normale Taste, zum Beispiel Ctrl + Umschalttaste + D."
          }
        }
      }
    },
    "Compact": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt"
          }
        }
      }
    },
    "Copy Last Dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Diktat kopieren"
          }
        }
      }
    },
    "Couldn’t Export the Dictionary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuch konnte nicht exportiert werden"
          }
        }
      }
    },
    "Couldn’t Import the Dictionary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuch konnte nicht importiert werden"
          }
        }
      }
    },
    "Couldn’t download the speech model: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell konnte nicht geladen werden: %@."
          }
        }
      }
    },
    "Couldn’t load the speech model: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell konnte nicht gestartet werden: %@"
          }
        }
      }
    },
    "Couldn’t paste. Try again, or restart Pladder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen fehlgeschlagen. Versuche es noch einmal oder starte Pladder neu."
          }
        }
      }
    },
    "Couldn’t use the microphone: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist nicht verfügbar: %@"
          }
        }
      }
    },
    "Custom words": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Wörter"
          }
        }
      }
    },
    "Dictionary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuch"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerfen"
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird geladen …"
          }
        }
      }
    },
    "Downloading the speech model…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachmodell wird geladen …"
          }
        }
      }
    },
    "Downloading the speech model… %lld%%": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachmodell wird geladen … %lld %%"
          }
        }
      }
    },
    "Drops “uh”, “um” and “äh”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt „äh“, „ähm“ und „uh“."
          }
        }
      }
    },
    "Export…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren …"
          }
        }
      }
    },
    "Fixes self-corrections, lists and punctuation before pasting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert Selbstkorrekturen, Listen und Satzzeichen vor dem Einfügen."
          }
        }
      }
    },
    "For a dictation of one sentence up to ten words, such as a reply to an agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Diktat aus einem Satz mit bis zu zehn Wörtern, etwa eine Antwort an einen Agenten."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemein"
          }
        }
      }
    },
    "Hands-free": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freihändig"
          }
        }
      }
    },
    "Heard as": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehört als"
          }
        }
      }
    },
    "Hold %@ to dictate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten"
          }
        }
      }
    },
    "Hold %@ to dictate (Secure Keyboard Entry is on)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten (sichere Tastatureingabe ist an)"
          }
        }
      }
    },
    "Hold %@ to dictate, then press ⌘V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren %@ gedrückt halten, dann ⌘V drücken"
          }
        }
      }
    },
    "Hugging Face is limiting downloads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face begrenzt die Downloads"
          }
        }
      }
    },
    "Hugging Face returned an error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face hat einen Fehler zurückgegeben"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
