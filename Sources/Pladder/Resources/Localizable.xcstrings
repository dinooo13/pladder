    "Press keys…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten drücken…"
          }
        }
      }
    },
    "Press the key or combination to use. Escape cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewünschte Taste oder Tastenkombination drücken. Esc bricht ab."
          }
        }
      }
    },
    "Press the key or combination to use. Escape cancels. Without Accessibility the key must include a regular key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewünschte Taste oder Tastenkombination drücken. Esc bricht ab. Ohne Bedienungshilfen muss die Kombination eine normale Taste enthalten, zum Beispiel Steuerungstaste + Umschalttaste + D."
          }
        }
      }
    },
