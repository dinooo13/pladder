    },
    "Shows the words as you speak them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Wörter, während du sie sprichst."
          }
        }
      }
    },
    "So the next dictation does not run into this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit das nächste Diktat nicht an dieses anstößt."
          }
        }
