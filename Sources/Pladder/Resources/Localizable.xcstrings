{
  "sourceLanguage": "en",
  "strings": {
    "%@ is a macOS keyboard shortcut and will fire as well.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein macOS-Tastaturkurzbefehl und wird ebenfalls ausgelöst."
          }
        }
      }
    },
    "%@ is a macOS keyboard shortcut, so %@ may never reach Pladder. Change one of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist ein macOS-Tastaturkurzbefehl, daher erreicht %2$@ Pladder möglicherweise nie. Ändere eines von beiden."
          }
        }
      }
    },
    "%@ is part of the push-to-talk key, so it can never be pressed separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist Teil der Push-to-Talk-Taste und kann daher nie einzeln gedrückt werden."
          }
        }
      }
    },
    "Add a rule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel hinzufügen"
          }
        }
      }
    },
    "Add examples": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiele hinzufügen"
          }
        }
      }
    },
    "Animation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Append a space after each dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Diktat ein Leerzeichen anfügen"
          }
        }
      }
    },
    "Applies your replacement rules. Edit them in the Dictionary tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet deine Ersetzungsregeln an. Bearbeite sie im Tab „Wörterbuch“."
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch"
          }
        }
      }
    },
    "Background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund"
          }
        }
      }
    },
    "Chill": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemächlich"
          }
        }
      }
    },
    "Choose a key combination in Settings (Accessibility is off)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombination in den Einstellungen wählen (Bedienungshilfen sind aus)"
          }
        }
      }
    },
    "Click, then press the key or combination to use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken und dann die gewünschte Taste oder Tastenkombination drücken."
          }
        }
      }
    },
    "Click, then press the key or combination to use. Without Accessibility the key must include a regular key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken und dann die gewünschte Taste oder Tastenkombination drücken. Ohne Bedienungshilfen muss die Kombination eine normale Taste enthalten, zum Beispiel Steuerungstaste + Umschalttaste + D."
          }
        }
      }
    },
    "Compact": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt"
          }
        }
      }
    },
    "Copied — press ⌘V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert — ⌘V drücken"
          }
        }
      }
    },
    "Could not create the paste keystroke. Try again, or restart Pladder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tastendruck zum Einfügen konnte nicht erzeugt werden. Versuche es erneut oder starte Pladder neu."
          }
        }
      }
    },
    "Could not read that file. It should be a JSON array of { from, to, matchCase }.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht gelesen werden. Sie sollte ein JSON-Array aus { from, to, matchCase } sein."
          }
        }
      }
    },
    "Could not write that file: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht geschrieben werden: %@"
          }
        }
      }
    },
    "Custom words": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Wörter"
