      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgeschlagene Korrekturen"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        }
      }
    },
    "The file should be a dictionary exported from Pladder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei sollte ein aus Pladder exportiertes Wörterbuch sein."
          }
        }
      }
    },
    "The send key needs Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sendetaste braucht die Bedienungshilfen."
          }
        }
      }
    },
    "The speech model isn’t loaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell ist nicht geladen."
          }
        }
      }
    },
    "The speech model’s files are incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien des Sprachmodells sind unvollständig."
          }
        }
      }
    },
    "This rule undoes another one, so it is ignored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regel hebt eine andere auf und wird deshalb ignoriert."
          }
        }
      }
    },
    "Tidy whitespace": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerzeichen bereinigen"
          }
        }
      }
    },
    "Transcribing…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird transkribiert …"
          }
        }
      }
    },
    "Trims the transcript and collapses runs of spaces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Leerzeichen am Anfang und Ende und fasst mehrere Leerzeichen zu einem zusammen."
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        }
      }
    },
    "Turned off for Pladder. Turn it on in System Settings to dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Pladder ausgeschaltet. Schalte es in den Systemeinstellungen ein, um zu diktieren."
          }
        }
      }
    },
    "Two rules undo each other, so both are ignored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Regeln heben sich auf und werden beide ignoriert."
          }
        }
      }
    },
    "Type a sentence to see how the rules change it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Satz ein und sieh, was die Regeln daraus machen"
          }
        }
      }
    },
    "Without a modifier, %@ can no longer be typed in other apps while Pladder is running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Sondertaste lässt sich %@ in anderen Apps nicht mehr tippen, solange Pladder läuft."
          }
        }
      }
    },
